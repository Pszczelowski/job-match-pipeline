# Settings for compose.yaml. Copy this file to compose.env (untracked, never committed) and edit it.
# Use it with:  docker compose --env-file compose.env up -d --build
# This file holds paths and numbers only. Passwords belong in the .env file named by SECRETS_FILE below.

# Host folders. Relative paths start at the folder that holds compose.yaml. On Windows use forward slashes
# (C:/Users/Alex/Recruitment-data/data). The folders must exist before the first start.
DATA_DIR=./data
EXCHANGE_DIR=./exchange
OUTPUT_DIR=./output
BACKUP_DIR=./backups
LOGS_DIR=./logs

# Private files on the host (mounted read-only). Both must exist before the first start.
CONFIG_FILE=./config.yaml
SECRETS_FILE=./.env

# The llm service (profile "llm" in compose.yaml; DEPLOYMENT_MANUAL.md section 15): its own home folder (the CLI's login state) and the file
# with its one login line. The login file is NOT the .env above: the scheduler and the web service must never see it.
LLM_HOME_DIR=./llm-home
LLM_SECRETS_FILE=./llm.env

# The user inside the container. Docker Desktop on Windows: keep the defaults. Linux or NAS: the number of the
# user that owns the folders above (run 'id' there), so the container may write into them.
APP_UID=10001
APP_GID=10001

# Image tag. Change it to keep an older image for a roll-back (DEPLOYMENT_MANUAL.md, updates).
IMAGE_TAG=local

# The web service (profile "web" in compose.yaml; DEPLOYMENT_MANUAL.md section 9). It starts only when COMPOSE_PROFILES=web.
# The web port is published on two host addresses, never on all interfaces. Both default to 127.0.0.1 (Docker Desktop test; compose
# never fails when they are unset). NAS: WEB_BIND_IP = its home LAN address (192.0.2.3), WEB_BIND_IP_ZT = its ZeroTier address.
# The router must not forward this port; the login stays on.
WEB_BIND_IP=127.0.0.1
WEB_BIND_IP_ZT=127.0.0.1
# The container port is fixed at 8000; WEB_PORT changes only the host port.
WEB_PORT=8000
# NAS: web,llm (a plain 'up -d' then also starts the web service and the headless worker). PC: leave empty (only the scheduler service starts).
COMPOSE_PROFILES=
